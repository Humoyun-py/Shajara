# ─── AVLOD environment ─────────────────────────────────────────────────────────
# Copy to `.env` (repo root). Placeholder values only — never commit real secrets.

NODE_ENV=development

# API
API_PORT=4000
# Public origin of the web app (used for CORS, CSRF origin checks and email links)
WEB_ORIGIN=http://localhost:5173

# PostgreSQL (matches docker-compose defaults). With `npm run db:embedded` use port 54329.
POSTGRES_USER=avlod
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=avlod
DATABASE_URL=postgresql://avlod:change-me-local-only@localhost:5432/avlod?schema=public

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set to true behind HTTPS in production
COOKIE_SECURE=false

# Media storage: `local` (files on disk, HMAC-signed URLs) or `s3` (any S3-compatible service)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
MEDIA_URL_SECRET=replace-with-another-long-random-string
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=avlod-media
S3_ACCESS_KEY_ID=avlod-local
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true

# Upload limits (bytes)
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200

# Email (password reset, invitations). If SMTP_HOST is empty, emails are written to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AVLOD <no-reply@avlod.local>"

# Public demo family on the landing page (seeded fictional data)
PUBLIC_DEMO_ENABLED=true
